{
  "name": "@joaodotwork/plantas-github-projects-mcp",
  "version": "1.6.0",
  "description": "Plantas GitHub Projects v2 MCP server (unofficial) - automation for creating projects, milestones, issues, and iterations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "github-projects-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "github",
    "projects",
    "automation",
    "model-context-protocol",
    "github-api",
    "project-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joaodotwork/plantas-github-projects-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/joaodotwork/plantas-github-projects-mcp/issues"
  },
  "homepage": "https://github.com/joaodotwork/plantas-github-projects-mcp#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "João Doria de Souza",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/auth-oauth-device": "^8.0.4",
    "@octokit/graphql": "^8.2.2",
    "@octokit/oauth-methods": "^6.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
